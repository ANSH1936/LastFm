{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app/streamlit_app.py"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Train LightGCN (quick)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train.py",
      "args": ["--quick"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
